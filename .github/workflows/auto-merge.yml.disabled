# Vanilla GitHub Actions alternative to Mergify for the Codex parallel
# workflow (P3 merge broker).
#
# Activate by renaming this file:
#   .github/workflows/auto-merge.yml.disabled → .github/workflows/auto-merge.yml
#
# Pick this instead of Mergify when you don't want a third-party app on
# your repo.  Behaviour is equivalent: a PR labelled ``auto-merge`` with
# passing CI ``test`` and an approving review is auto-merged via squash.

name: auto-merge codex PRs

on:
  pull_request:
    types: [labeled, unlabeled, synchronize]
  check_suite:
    types: [completed]
  pull_request_review:
    types: [submitted]

permissions:
  contents: write
  pull-requests: write
  checks: read

jobs:
  auto-merge:
    runs-on: ubuntu-latest
    if: contains(github.event.pull_request.labels.*.name, 'auto-merge')
    steps:
      - name: enable auto-merge
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          PR="${{ github.event.pull_request.number }}"
          # Wait briefly for the check suite to settle.
          sleep 5
          STATUS=$(gh pr view "$PR" --json mergeStateStatus --jq .mergeStateStatus)
          if [ "$STATUS" = "CLEAN" ]; then
            gh pr merge "$PR" --squash --auto
          elif [ "$STATUS" = "BLOCKED" ]; then
            echo "PR #$PR blocked (likely missing review) — skipping."
          else
            echo "PR #$PR mergeStateStatus=$STATUS — skipping."
          fi
